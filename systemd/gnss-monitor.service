[Unit]
Description=GNSS Monitor Maritime — ZED-X20P vessel threat detection
After=network.target
Conflicts=gpsd.service

[Service]
Type=simple
User=obs-pi-01
Group=obs-pi-01
WorkingDirectory=/home/obs-pi-01/gnss-monitor-maritime
Environment=HOME=/home/obs-pi-01
Environment=PYTHONPATH=/home/obs-pi-01/.local/lib/python3.13/site-packages
EnvironmentFile=-/home/obs-pi-01/gnss-monitor-maritime/.env
ExecStart=/usr/bin/python3 /home/obs-pi-01/gnss-monitor-maritime/app.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=gnss-monitor-maritime

# Allow access to serial device
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
